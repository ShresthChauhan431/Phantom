# Phantom Environment Configuration

# Cloud VLM API Key (OpenAI-compatible: Groq / NVIDIA)
# Groq keys: https://console.groq.com/keys
PHANTOM_CLOUD_VLM_KEY=

# Model used when the provider is groq/nvidia.
# Groq's generally-available vision model; supports JSON mode WITH images, and the
# Qwen-VL family is the strongest open family at spatial grounding (needed for bbox).
PHANTOM_CLOUD_MODEL=qwen/qwen3.8-27b

# API Configuration
PHANTOM_API_HOST=localhost
PHANTOM_API_PORT=8000

# VLM Provider: local | nvidia | groq | mock
PHANTOM_VLM_PROVIDER=local

# Ollama Configuration (for local VLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-vl:latest

# Database
PHANTOM_DB_PATH=data/phantom.db

# Capture Configuration
PHANTOM_CAPTURE_INTERVAL=2
PHANTOM_RETENTION_HOURS=168  # 7 days

# Gate tuning. Calibrate against your own scene with:
#   python scripts/check_camera.py --source iphone
#   python scripts/watch_gate.py --source iphone     (see transient filtering live)
#
# Fraction of changed pixels that counts as motion. run_all.py applies the
# calibrated live values when these are unset: open 9px, motion 0.005, change 0.006.
PHANTOM_MOTION_THRESHOLD=0.01
# Morphological opening (px) on the change mask. Removes the edge shimmer a live
# phone stream shows on a still scene (measured: 4.9% -> 0.2% of pixels). 0 = off.
PHANTOM_GATE_OPEN_KSIZE=0
# How long the scene must hold still before a change is treated as finished.
# Must outlast a human pause: at 0.6s a hand hovering mid-reach was recorded as a
# change; at ~1.8s+ the hand withdraws first and gets filtered out as transient.
PHANTOM_SETTLE_SECONDS=2
# Explicit quiet-frame override; 0 derives it from PHANTOM_SETTLE_SECONDS.
PHANTOM_SETTLE_FRAMES=0
# How different the settled scene must be from before the motion to count as real.
# This is what ignores hands and passers-by: they leave the scene unchanged, so
# nothing is committed. 0 = use PHANTOM_MOTION_THRESHOLD.
PHANTOM_CHANGE_THRESHOLD=0

# Camera Source: android | iphone | replay   (NO webcam — see shared-contracts §9)
PHANTOM_CAMERA_SOURCE=replay
# Folder of recorded frames used when PHANTOM_CAMERA_SOURCE=replay
PHANTOM_REPLAY_DIR=tests/fixtures/frames
# How to capture from an iPhone:
#   bridge = Swift/AVFoundation helper (default; the ONLY way to reach a
#            Continuity Camera — OpenCV cannot, see docs/working/dhwanit.md §E)
#   index  = OpenCV by device index, for a webcam-bridge app such as Camo
PHANTOM_IPHONE_CAPTURE=bridge
# Optional: pin one AVFoundation device by uniqueID (list them with
# `swift scripts/avf_devices.swift`). Empty = first device named "iPhone".
PHANTOM_IPHONE_UNIQUE_ID=
# Device index, used only when PHANTOM_IPHONE_CAPTURE=index or for android.
# Find it with: python scripts/list_cameras.py
PHANTOM_CAMERA_INDEX=0
# Stream URL for a phone camera app (RTSP/MJPEG). Works for both iphone and android,
# needs no Mac-side driver, e.g. rtsp://192.168.1.42:8554/live
PHANTOM_CAMERA_URL=
